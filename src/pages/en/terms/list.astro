---
import { Button, CardList } from '@/components/user'
import { cn } from '@/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ, terms } from '@/site-config'

const meta = {
  title: 'Site policy',
  description: 'Privacy and copyright notes for this site'
}

const englishTerms = {
  ...terms,
  list: terms.list.map((item) => ({ ...item, link: `/en${item.link}` }))
}
---

<PageLayout {meta}>
  <Button title='Back' href='/en' style='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Site Policy</h1>
    </div>

    <div id='content' class={cn('animate mt-8 max-w-none md:min-w-[45ch]', integ.typography.class)}>
      <h2 class='text-xl font-medium'>Privacy and copyright</h2>
      <CardList {...englishTerms} />
    </div>
  </main>
</PageLayout>
