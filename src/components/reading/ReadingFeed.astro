---
import type { BlogFeedItem, BlogFeedSource } from '@/types/reading'
import { FormattedDate, Icon } from '@/components/user'

import FeedSourceCard from './FeedSourceCard.astro'

interface Props {
  sources: BlogFeedSource[]
  items: BlogFeedItem[]
  newItemIds: string[]
  monitoringStartedAt: string | null
  contentUpdatedAt: string | null
  locale: 'zh' | 'en'
}

const { sources, items, newItemIds, monitoringStartedAt, contentUpdatedAt, locale } = Astro.props
const isEnglish = locale === 'en'
const labels = isEnglish
  ? {
      description:
        'Every subscribed blog has its own place here. New posts appear under their source after monitoring begins.',
      monitoredSince: 'Monitoring since',
      sourceCount: `${sources.length} sources`,
      statusPrefix: 'New posts',
      title: 'Blog Subscriptions',
      updated: 'Feed content updated'
    }
  : {
      description: '每个订阅博客都有自己的位置；开始监控后发布的新文章，会出现在对应来源中。',
      monitoredSince: '监控开始于',
      sourceCount: `${sources.length} 个订阅源`,
      statusPrefix: '当前新文章',
      title: '博客订阅',
      updated: '订阅内容更新于'
    }
const monitoringStartedDate = monitoringStartedAt ? new Date(monitoringStartedAt) : null
const updatedDate = contentUpdatedAt ? new Date(contentUpdatedAt) : null
const newIdSet = new Set(newItemIds)
const itemsBySource = new Map<string, BlogFeedItem[]>()
const recentItemBySource = new Map<string, BlogFeedItem>()

for (const source of sources) itemsBySource.set(source.id, [])
for (const item of items) {
  if (!recentItemBySource.has(item.source_id)) recentItemBySource.set(item.source_id, item)
  if (!newIdSet.has(item.id)) continue
  itemsBySource.get(item.source_id)?.push(item)
}
---

<reading-feed class='mx-auto block max-w-6xl'>
  <header class='mb-8 space-y-4'>
    <div class='flex items-start gap-4'>
      <div
        class='flex size-11 shrink-0 items-center justify-center rounded-xl border border-border bg-muted text-primary'
      >
        <Icon class='size-5' name='rss' />
      </div>
      <div class='space-y-1'>
        <h1 class='text-3xl font-semibold tracking-tight text-foreground'>{labels.title}</h1>
        <p class='max-w-2xl text-sm leading-6 text-muted-foreground'>{labels.description}</p>
      </div>
    </div>

    <div
      class='flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-border pt-4 text-xs text-muted-foreground'
    >
      <span>{labels.sourceCount}</span>
      {
        monitoringStartedDate && (
          <>
            <span aria-hidden='true'>·</span>
            <span>
              {labels.monitoredSince}{' '}
              <FormattedDate
                class='font-sans'
                date={monitoringStartedDate}
                dateTimeOptions={{ hour: '2-digit', minute: '2-digit' }}
              />
            </span>
          </>
        )
      }
      {
        updatedDate && (
          <>
            <span aria-hidden='true'>·</span>
            <span>
              {labels.updated}{' '}
              <FormattedDate
                class='font-sans'
                date={updatedDate}
                dateTimeOptions={{ hour: '2-digit', minute: '2-digit' }}
              />
            </span>
          </>
        )
      }
    </div>
  </header>

  {/* Third-party article metadata must stay out of this site's own search index. */}
  <ul
    class='grid grid-cols-1 items-stretch gap-4 md:grid-cols-2 lg:grid-cols-3'
    data-pagefind-ignore
    data-source-grid
  >
    {
      sources.map((source) => (
        <FeedSourceCard
          source={source}
          items={itemsBySource.get(source.id) ?? []}
          recentItem={recentItemBySource.get(source.id)}
          locale={locale}
        />
      ))
    }
  </ul>

  <span
    class='sr-only'
    data-reading-status
    data-status-prefix={labels.statusPrefix}
    aria-atomic='true'
    aria-live='polite'></span>
</reading-feed>

<script>
  const STORAGE_KEY = 'blog-reading-read:v2'

  function loadAcknowledgedIds() {
    try {
      const value = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]')
      return Array.isArray(value) ? value.filter((id) => typeof id === 'string').slice(-1000) : []
    } catch {
      return []
    }
  }

  class ReadingFeedElement extends HTMLElement {
    clickListener?: (event: Event) => void
    storageListener?: (event: StorageEvent) => void

    connectedCallback() {
      if (this.dataset.initialized === 'true') return
      this.dataset.initialized = 'true'

      const cards = [...this.querySelectorAll<HTMLElement>('[data-source-card]')]
      const status = this.querySelector<HTMLElement>('[data-reading-status]')
      let acknowledgedIds = loadAcknowledgedIds()
      let acknowledgedSet = new Set(acknowledgedIds)

      const saveAcknowledgedIds = () => {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(acknowledgedIds.slice(-1000)))
        } catch {
          return
        }
      }

      const render = () => {
        let totalNew = 0

        for (const card of cards) {
          const items = [...card.querySelectorAll<HTMLElement>('[data-source-item]')]
          const count = card.querySelector<HTMLElement>('[data-source-count]')
          const emptyState = card.querySelector<HTMLElement>('[data-source-empty]')
          let visibleItemFound = false
          let newCount = 0

          for (const item of items) {
            const isAcknowledged = acknowledgedSet.has(item.dataset.entryId || '')
            if (!isAcknowledged) newCount += 1
            item.hidden = isAcknowledged || visibleItemFound
            if (!isAcknowledged && !visibleItemFound) visibleItemFound = true
          }

          totalNew += newCount
          card.dataset.hasNew = String(newCount > 0)
          if (count) {
            count.hidden = newCount === 0
            if (newCount > 0) {
              count.textContent = `${newCount} ${count.dataset.countSuffix || ''}`.trim()
              count.setAttribute(
                'aria-label',
                `${newCount} ${count.dataset.countAriaSuffix || ''}`.trim()
              )
            } else {
              count.textContent = ''
              count.removeAttribute('aria-label')
            }
          }
          if (emptyState) emptyState.hidden = newCount > 0
        }

        this.dataset.hydrated = 'true'
        if (status) status.textContent = `${status.dataset.statusPrefix || ''}: ${totalNew}`
      }

      this.clickListener = (event) => {
        const target = event.target
        if (!(target instanceof Element)) return
        const link = target.closest('[data-source-item-link]')
        const item = link?.closest<HTMLElement>('[data-source-item]')
        const card = item?.closest<HTMLElement>('[data-source-card]')
        const id = item?.dataset.entryId
        if (!id || acknowledgedSet.has(id)) return
        const shouldRestoreFocus = event instanceof MouseEvent && event.detail === 0

        acknowledgedIds = [...acknowledgedIds.filter((value) => value !== id), id].slice(-1000)
        acknowledgedSet = new Set(acknowledgedIds)
        saveAcknowledgedIds()
        window.setTimeout(() => {
          render()
          if (!shouldRestoreFocus || !card) return
          card
            .querySelector<HTMLElement>(
              '[data-source-item]:not([hidden]) [data-source-item-link], [data-source-quiet]:not([hidden]) a, header a'
            )
            ?.focus({ preventScroll: true })
        }, 0)
      }
      this.addEventListener('click', this.clickListener)

      this.storageListener = (event) => {
        if (event.key !== STORAGE_KEY) return
        acknowledgedIds = loadAcknowledgedIds()
        acknowledgedSet = new Set(acknowledgedIds)
        render()
      }
      window.addEventListener('storage', this.storageListener)

      render()
    }

    disconnectedCallback() {
      if (this.clickListener) this.removeEventListener('click', this.clickListener)
      if (this.storageListener) window.removeEventListener('storage', this.storageListener)
      this.clickListener = undefined
      this.storageListener = undefined
      delete this.dataset.initialized
    }
  }

  if (!customElements.get('reading-feed')) {
    customElements.define('reading-feed', ReadingFeedElement)
  }
</script>

<style>
  reading-feed:not([data-hydrated='true']) :global([data-source-item]:not(:first-child)),
  :global([data-source-item][hidden]),
  :global([data-source-empty][hidden]) {
    display: none;
  }
</style>
