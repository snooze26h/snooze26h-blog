---
import type { BlogFeedItem } from '@/types/reading'
import { FormattedDate } from '@/components/user'

interface Props {
  item: BlogFeedItem
}

const { item } = Astro.props
---

<li
  class='group/card relative rounded-2xl border border-border bg-background px-5 py-4 transition-colors ease-in-out hover:bg-muted max-sm:px-4'
  data-entry-id={item.id}
  data-read='false'
  data-reading-item
>
  <a
    class='group/link flex flex-col gap-2 transition-colors hover:text-primary'
    data-reading-link
    href={item.url}
    rel='noopener noreferrer'
    target='_blank'
  >
    <div class='flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground'>
      <span
        class='unread-dot size-1.5 shrink-0 rounded-full bg-primary transition-opacity'
        aria-hidden='true'></span>
      <span class='font-medium text-foreground/80'>{item.source_name}</span>
      <span aria-hidden='true'>·</span>
      <FormattedDate
        class='font-sans'
        date={new Date(item.published_at)}
        dateTimeOptions={{ hour: '2-digit', minute: '2-digit' }}
      />
    </div>

    <div class='flex items-start justify-between gap-4'>
      <h2
        class='text-base font-medium text-foreground transition-colors group-hover/link:text-primary'
      >
        {item.title}
      </h2>
      <svg
        xmlns='http://www.w3.org/2000/svg'
        width='16'
        height='16'
        viewBox='0 0 24 24'
        fill='none'
        stroke-width='2.5'
        stroke-linecap='round'
        stroke-linejoin='round'
        class='mt-1 shrink-0 stroke-muted-foreground group-hover/link:stroke-primary'
        aria-hidden='true'
      >
        <line
          x1='5'
          y1='12'
          x2='19'
          y2='12'
          class='translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1 group-hover/link:scale-x-100'
        ></line>
        <polyline
          points='12 5 19 12 12 19'
          class='translate-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1'
        ></polyline>
      </svg>
    </div>

    {
      item.summary && (
        <p class='line-clamp-2 text-sm leading-6 text-muted-foreground'>{item.summary}</p>
      )
    }
  </a>
</li>

<style>
  [data-reading-item][data-read='true'] .unread-dot {
    opacity: 0;
  }

  [data-reading-item][hidden] {
    display: none;
  }
</style>
